# AI Montage Agent 环境配置

# Redis配置
REDIS_URL=redis://localhost:6379/0

# 数据库配置
DATABASE_URL=postgresql://user:password@localhost:5432/ai_montage

# FFmpeg配置
FFMPEG_PATH=ffmpeg

# 日志级别
LOG_LEVEL=INFO

# API配置
API_HOST=0.0.0.0
API_PORT=8000

# 临时文件目录
TEMP_DIR=./temp
OUTPUT_DIR=./output

# 模型配置
CLIP_MODEL=openai/clip-vit-base-patch32
WHISPER_MODEL=base

# 处理配置
MAX_VIDEO_DURATION=600  # 最大视频时长(秒)
MAX_SHOTS=100  # 最大镜头数
DEFAULT_FPS=30
DEFAULT_RESOLUTION=1920x1080
